generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  full_name               String?
  avatar_url              String?                  @map("avatar_url")
  provider                String                   @default("email")
  provider_id             String?                  @unique
  password_hash           String?
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    UserRole                 @default(USER)
  bankAccounts            BankAccount[]
  consumptionTransactions ConsumptionTransaction[]
  contactMessages         ContactMessage[]
  orders                  Order[]
  organizer               Organizer?
  queueEntries            QueueEntry[]
  staffMembers            StaffMember[]
  tickets                 Ticket[]
  auditLogs               AuditLog[]
}

model Organizer {
  id                String        @id @default(cuid())
  userId            String        @unique @map("user_id")
  businessName      String        @map("business_name")
  bankAccount       String?       @map("bank_account")
  phone             String?
  logoUrl           String?       @map("logo_url")
  verified          Boolean       @default(false) @map("verified")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  description       String?
  fiscalId          String?       @map("fiscal_id")
  events            Event[]
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffMembers      StaffMember[]

  // 🔑 Campos OAuth para Marketplace / Split Payments
  mercadopagoUserId       String?   @map("mercadopago_user_id")
  mercadopagoAccessToken  String?   @map("mercadopago_access_token")
  mercadopagoRefreshToken String?   @map("mercadopago_refresh_token")
  mercadopagoPublicKey    String?   @map("mercadopago_public_key")
  mercadopagoExpiresAt    DateTime? @map("mercadopago_expires_at")
}

model StaffMember {
  id          String    @id @default(cuid())
  organizerId String    @map("organizer_id")
  userId      String    @map("user_id")
  role        String    @default("STAFF")
  permissions Json?     @default("{}")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerId, userId])
}

enum EventType {
  PRESENCIAL
  STREAMING
  HIBRIDO
}

model Event {
  id              String       @id @default(cuid())
  organizerId     String       @map("organizer_id")
  title           String
  description     String?
  dateTime        DateTime     @map("date_time")
  endDateTime     DateTime?    @map("end_date_time")
  locationName    String       @map("location_name")
  locationAddress String       @map("location_address")
  locationLat     Float?       @map("location_lat")
  locationLng     Float?       @map("location_lng")
  bannerUrl       String?      @map("banner_url")
  category        String
  type            EventType    @default(PRESENCIAL) @map("event_type")
  streamingUrl    String?
  streamingKey    String?
  status          String       @default("borrador")
  featured        Boolean      @default(false)
  minPrice        Float?       @map("min_price")
  totalCapacity   Int?         @map("total_capacity")
  packId          String?      @map("pack_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  queueActive     Boolean      @default(false) @map("queue_active")     // Enciende/Apaga la sala manualmente
  maxConcurrent   Int          @default(50)    @map("max_concurrent")   // Límite de usuarios simultáneos en Checkout
  maxTicketsPerUser Int        @default(4) @map("max_tickets_per_user")

  organizer       Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  pack            EventPack?   @relation(fields: [packId], references: [id])
  orders          Order[]
  queueEntries    QueueEntry[]
  tickets         Ticket[]
  ticketTypes     TicketType[]
  auditLogs       AuditLog[]
}

/// Cómo aplica el % de comisión (solo si `commissionType` es porcentaje).
/// En PostgreSQL los valores del enum son en español; en TypeScript/JSON de Prisma se usan los identificadores ADICIONA_AL_PRECIO / DEDUCE_DEL_PRECIO.
enum PackPercentApplyMode {
  ADICIONA_AL_PRECIO @map("adiciona al precio")
  DEDUCE_DEL_PRECIO  @map("deduce del precio")
}

model EventPack {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  hasPhysicalTickets     Boolean  @default(true) @map("has_physical_tickets")
  hasDigitalTickets      Boolean  @default(false) @map("has_digital_tickets")
  hasQrValidation        Boolean  @default(false) @map("has_qr_validation")
  hasConsumptions        Boolean  @default(false) @map("has_consumptions")
  hasStaffManagement     Boolean  @default(false) @map("has_staff_management")
  commissionType         String   @default("porcentaje") @map("commission_type")
  commissionTickets      Float    @default(0) @map("commission_tickets")
  commissionConsumptions Float    @default(0) @map("commission_consumptions")
  /// Aplica solo si `commissionType === "porcentaje"`: cómo se aplica `commissionTickets` sobre entradas.
  ticketPercentApply        PackPercentApplyMode @default(ADICIONA_AL_PRECIO) @map("ticket_percent_apply")
  /// Aplica solo si `commissionType === "porcentaje"`: cómo se aplica `commissionConsumptions` sobre consumiciones.
  consumptionPercentApply PackPercentApplyMode @default(ADICIONA_AL_PRECIO) @map("consumption_percent_apply")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  events                 Event[]
}

model TicketType {
  id             String      @id @default(cuid())
  eventId        String      @map("event_id")
  name           String
  description    String?
  price          Float
  stockTotal     Int         @map("stock_total")
  stockAvailable Int         @map("stock_available")
  maxPerUser     Int         @default(4) @map("max_per_user")

  ticketsPerBundle     Int          @default(1) // Cantidad de personas que entran con 1 compra
  // 💡 Lógica de Packs y Vinculación de Aforo
  isPack               Boolean      @default(false)
  parentTicketTypeId   String?      // ID del ticket del cual consume aforo (ej. General)
  parentTicketType     TicketType?  @relation("TicketTypePacks", fields: [parentTicketTypeId], references: [id], onDelete: SetNull)
  childPacks           TicketType[] @relation("TicketTypePacks")

  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orderItems     OrderItem[]
  tickets        Ticket[]
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String      @id @default(cuid())
  userId                String      @map("user_id")
  userEmail             String      @map("user_email")
  userName              String      @map("user_name")
  eventId               String      @map("event_id")
  eventTitle            String      @map("event_title")
  totalAmount           Float       @map("total_amount")
  paymentStatus         String      @default("pendiente") @map("payment_status")
  externalTransactionId String?     @map("external_transaction_id")
  paymentMethod         String?     @map("payment_method")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  event                 Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  tickets               Ticket[]
}

model OrderItem {
  id             String     @id @default(cuid())
  orderId        String     @map("order_id")
  ticketTypeId   String     @map("ticket_type_id")
  ticketTypeName String     @map("ticket_type_name")
  quantity       Int
  unitPrice      Float      @map("unit_price")
  subtotal       Float
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                      String                   @id @default(cuid())
  orderId                 String                   @map("order_id")
  ticketTypeId            String                   @map("ticket_type_id")
  eventId                 String                   @map("event_id")
  userId                  String                   @map("user_id")
  eventTitle              String                   @map("event_title")
  eventDate               String                   @map("event_date")
  eventLocation           String                   @map("event_location")
  ticketTypeName          String                   @map("ticket_type_name")
  accessToken             String?                  @unique @map("access_token")
  qrCode                  String                   @unique @map("qr_code")
  usageStatus             String                   @default("no_usado") @map("usage_status")
  holderName              String                   @map("holder_name")
  holderEmail             String                   @map("holder_email")
  consumptionBalance      Float                    @default(0) @map("consumption_balance")
  consumptionInitial      Float                    @default(0) @map("consumption_initial")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  consumptionTransactions ConsumptionTransaction[]
  event                   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order                   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType              TicketType               @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingDeduction        Float?   // El monto que el staff quiere cobrar
  pendingOperatorId       String?  // El ID del staff que inició el cobro
  pendingExpiresAt        DateTime? // Tiempo límite para que el usuario confirme (ej: 1 minuto)
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  alias         String?
  cbu           String
  bankName      String   @map("bank_name")
  accountHolder String   @map("account_holder")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsumptionTransaction {
  id             String   @id @default(cuid())
  ticketId       String   @map("ticket_id")
  userId         String   @map("user_id")
  eventId        String   @map("event_id")
  eventTitle     String   @map("event_title")
  ticketTypeName String   @map("ticket_type_name")
  type           String
  amount         Float
  balanceBefore  Float    @map("balance_before")
  balanceAfter   Float    @map("balance_after")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QueueEntry {
  id           String    @id @default(cuid())
  eventId      String    @map("event_id")
  userId       String    @map("user_id")
  sessionToken String    @unique @map("session_token")
  position     Int
  status       String    @default("waiting") // "waiting" | "admitted" | "expired"
  admittedAt   DateTime? @map("admitted_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relaciones correctas con ambas tablas
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices para optimizar el polleo constante de la Sala de Espera
  @@index([eventId, status])
  @@map("queue_entries")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("nuevo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "INGRESO_PUERTA", "CONSUMO_PENDIENTE", "CONSUMO_CONFIRMADO"
  eventId     String   @map("event_id")
  userId      String   @map("user_id")
  operatorId  String   @map("operator_id") // El ID del Staff que escaneó
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum UserRole {
  USER
  ADMIN
  ORGANIZER
  STAFF
}
