// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User role enum
enum UserRole {
  USER
  ADMIN
  ORGANIZER
}

// User model (TicketNow authentication)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  full_name     String?
  avatar_url    String?  @map("avatar_url")
  role          UserRole @default(USER)
  provider      String   @default("email") // email, google
  provider_id   String?  @unique // ID del proveedor (Google ID, etc.)
  password_hash String?  // Para login con email/contraseña
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  bankAccounts          BankAccount[]
  organizer             Organizer?
  consumptionTransactions ConsumptionTransaction[]
  orders                Order[]
  tickets               Ticket[]
  queueEntries           QueueEntry[]
  contactMessages        ContactMessage[]
}

// Organizer model
model Organizer {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  businessName String   @map("business_name")
  fiscalId     String?  @map("fiscal_id")
  bankAccount  String?  @map("bank_account")
  phone        String?
  logoUrl      String?  @map("logo_url")
  verified     Boolean  @default(false) @map("verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
}

// Event model
model Event {
  id              String    @id @default(cuid())
  organizerId      String    @map("organizer_id")
  title           String
  description     String?
  dateTime        DateTime  @map("date_time")
  endDateTime     DateTime? @map("end_date_time")
  locationName    String    @map("location_name")
  locationAddress String    @map("location_address")
  locationLat     Float?    @map("location_lat")
  locationLng     Float?    @map("location_lng")
  bannerUrl       String?   @map("banner_url")
  category        String    // musica, deportes, teatro, conferencia, festival, fiesta, gastronomia, otro
  status          String    @default("borrador") // borrador, publicado, finalizado, cancelado
  featured        Boolean   @default(false)
  minPrice        Float?     @map("min_price")
  totalCapacity   Int?       @map("total_capacity")
  packId          String?    @map("pack_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  organizer   Organizer   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  pack        EventPack?  @relation(fields: [packId], references: [id])
  ticketTypes TicketType[]
  orders      Order[]
  queueEntries QueueEntry[]
  tickets     Ticket[]
}

// EventPack model
model EventPack {
  id                     String  @id @default(cuid())
  name                   String
  description             String?
  hasPhysicalTickets       Boolean @default(true) @map("has_physical_tickets")
  hasDigitalTickets        Boolean @default(false) @map("has_digital_tickets")
  hasQrValidation        Boolean @default(false) @map("has_qr_validation")
  hasConsumptions         Boolean @default(false) @map("has_consumptions")
  hasStaffManagement      Boolean @default(false) @map("has_staff_management")
  commissionType         String  @default("porcentaje") @map("commission_type") // porcentaje, fijo
  commissionTickets       Float   @default(0) @map("commission_tickets")
  commissionConsumptions  Float   @default(0) @map("commission_consumptions")
  isActive               Boolean @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  events Event[]
}

// TicketType model
model TicketType {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  name         String
  description  String?
  price        Float
  stockTotal   Int      @map("stock_total")
  stockAvailable Int      @map("stock_available")
  maxPerUser   Int      @default(4) @map("max_per_user")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  event  Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  orderItems OrderItem[]
}

// Order model
model Order {
  id                        String   @id @default(cuid())
  userId                    String   @map("user_id")
  userEmail                 String   @map("user_email")
  userName                  String   @map("user_name")
  eventId                   String   @map("event_id")
  eventTitle                String   @map("event_title")
  totalAmount               Float     @map("total_amount")
  paymentStatus             String    @default("pendiente") @map("payment_status") // pendiente, aprobado, rechazado, reembolsado
  externalTransactionId      String?   @map("external_transaction_id")
  paymentMethod             String?   @map("payment_method")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items OrderItem[]
  tickets Ticket[]
}

// OrderItem model (embedded in Order)
model OrderItem {
  id             String @id @default(cuid())
  orderId        String @map("order_id")
  ticketTypeId   String @map("ticket_type_id")
  ticketTypeName String @map("ticket_type_name")
  quantity       Int
  unitPrice      Float  @map("unit_price")
  subtotal        Float

  // Relations
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
}

// Ticket model
model Ticket {
  id                    String   @id @default(cuid())
  orderId               String   @map("order_id")
  ticketTypeId          String   @map("ticket_type_id")
  eventId               String   @map("event_id")
  userId                String   @map("user_id")
  eventTitle            String   @map("event_title")
  eventDate             String   @map("event_date")
  eventLocation         String   @map("event_location")
  ticketTypeName        String   @map("ticket_type_name")
  qrCode                String   @unique @map("qr_code")
  usageStatus           String   @default("no_usado") @map("usage_status") // no_usado, ingresado, parcial, consumido
  holderName            String   @map("holder_name")
  holderEmail           String   @map("holder_email")
  consumptionBalance    Float     @default(0) @map("consumption_balance")
  consumptionInitial    Float     @default(0) @map("consumption_initial")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType          TicketType             @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  event               Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumptionTransactions ConsumptionTransaction[]
}

// BankAccount model
model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  alias         String?
  cbu           String
  bankName      String   @map("bank_name")
  accountHolder String   @map("account_holder")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ConsumptionTransaction model
model ConsumptionTransaction {
  id             String   @id @default(cuid())
  ticketId       String   @map("ticket_id")
  userId         String   @map("user_id")
  eventId        String   @map("event_id")
  eventTitle     String   @map("event_title")
  ticketTypeName String   @map("ticket_type_name")
  type           String   // credito, debito, reembolso
  amount         Float
  balanceBefore  Float     @map("balance_before")
  balanceAfter   Float     @map("balance_after")
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// QueueEntry model
model QueueEntry {
  id            String    @id @default(cuid())
  eventId       String    @map("event_id")
  userId        String    @map("user_id")
  sessionToken  String    @unique @map("session_token")
  position      Int
  status        String    @default("waiting") // waiting, admitted, completed, expired
  admittedAt    DateTime? @map("admitted_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ContactMessage model
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("nuevo") // nuevo, leido, respondido
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])
  userId String? @map("user_id")
}
